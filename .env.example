# Copy to .env and fill in as needed. The defaults run fully offline.

# --- Agent / LLM -------------------------------------------------------------
# "mock" (default, deterministic, offline), "anthropic", or "openai".
AGENT_PROVIDER=mock
# Each real provider is used only when AGENT_PROVIDER names it AND its key is
# set. Leave empty offline -- the factory falls back to mock if the key is
# missing, so a stray provider name never crashes a local run.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Per-provider default models (both overridable). AGENT_MODEL, if set, is a
# universal override that wins for whichever provider runs.
ANTHROPIC_MODEL=claude-opus-4-8
OPENAI_MODEL=gpt-4o
# AGENT_MODEL=

# --- GitHub webhook security -------------------------------------------------
# HMAC-SHA256 shared secret configured on the GitHub webhook.
GITHUB_WEBHOOK_SECRET=dev-only-insecure-secret-change-me
# How long a delivery id is remembered for replay protection (seconds).
REPLAY_TTL_SECONDS=600

# --- Langfuse (LLM observability) -------------------------------------------
# When both keys are set, tracing emits real spans; otherwise it no-ops locally.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# REGION MATTERS: keys authenticate against exactly one host; a wrong host gives
# a 401 on export. EU = https://cloud.langfuse.com, US = https://us.cloud.langfuse.com.
# LANGFUSE_BASE_URL is accepted as an alias for LANGFUSE_HOST.
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Rate limiting -----------------------------------------------------------
RATE_LIMIT_MAX_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# --- Eval gate ---------------------------------------------------------------
EVAL_PASS_THRESHOLD=0.80

# --- Audit -------------------------------------------------------------------
AUDIT_LOG_PATH=audit/audit.log.jsonl
